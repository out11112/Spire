# Independent SQLite database for Spire rooms and progress
SPIRE_DATABASE_URL=sqlite:///./spire.db

# LinkChat base URL used to verify user login sessions (GET /api/users/me)
# If deployed on the same host as LinkChat backend, you can use http://127.0.0.1:8000
LINKCHAT_AUTH_URL=https://linkchat.online

# Short in-memory cache TTL for verified LinkChat sessions (seconds)
AUTH_CACHE_TTL_SECONDS=30

# Bind host and port (single ASGI worker required for in-memory WebSocket leases)
SPIRE_HOST=0.0.0.0
SPIRE_PORT=8100
